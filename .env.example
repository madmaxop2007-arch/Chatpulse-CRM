# ChatPulse CRM - Firebase Web Configuration
# Replace these values with your actual Firebase Project web configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase Storage is OPTIONAL (Spark Plan: leave empty or disabled; CRM uses direct Image URLs)
VITE_FIREBASE_STORAGE_BUCKET=
# Set to 'true' only if Firebase Cloud Storage is provisioned on a Blaze plan
VITE_FIREBASE_STORAGE_ENABLED=false
